{
  "name": "pixel-paw",
  "version": "2.0.0",
  "description": "A cute pixel otter desktop companion for developers — reacts to your cursor and alerts when Claude, permissions, builds, or tools need you.",
  "main": "dist-electron/main.js",
  "bin": {
    "pixel-paw": "bin/pixel-paw.cjs"
  },
  "author": "PixelPaw",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "electron",
    "desktop",
    "pet",
    "otter",
    "companion",
    "claude",
    "developer-tools",
    "pixel-art",
    "desktop-pet"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anu-Code07/otter-js.git"
  },
  "homepage": "https://github.com/Anu-Code07/otter-js#readme",
  "bugs": {
    "url": "https://github.com/Anu-Code07/otter-js/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin",
    "dist",
    "dist-electron",
    "public/assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.node.json && vite build && tsc -p tsconfig.electron.json",
    "prepublishOnly": "npm run generate:sprites && npm run build",
    "package": "npm run build && electron-builder",
    "start": "node bin/pixel-paw.cjs",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "generate:sprites": "tsx scripts/generate-sprites.ts",
    "sprites:watercolor": "python3 scripts/process-watercolor-sprites.py"
  },
  "dependencies": {
    "electron": "^33.2.1",
    "electron-store": "^10.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron-builder": "^25.1.8",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "^25.0.1",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "com.pixelpaw.app",
    "productName": "PixelPaw",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "public/assets/**/*"
    ],
    "extraResources": [
      {
        "from": "public/assets",
        "to": "assets"
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": ["nsis", "portable"]
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility"
    }
  }
}
